	(text "3  Current-controlled backlight / active-low PWM"
		(at 282.54 26.35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8e84a53b-4a5d-517c-8909-0ef7e3148f47")
	)
	(text "Hirose FH12-8S-0.5SH(55), 0.5 mm pitch.\nFFC must reverse pin numbering between boards.\nDisplay pin 1 mates with main-board pin 8.\nMounting pads MP are grounded."
		(at 14 231 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "44f64477-1c56-572f-912a-8490521c35e6")
	)
	(text "Panel FPC: 12 contacts, 0.7 mm pitch.\nST7789V CS is permanently low; write-only SPI.\nPanel logic is 3.3V. Backlight anode is switched 5V.\nPin 2 LED_K goes to AL5802; never tie it to GND.\nBare-panel FPC/outline must be checked against the\nselected P133H002 manufacturer drawing."
		(at 144 231 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bebc63da-b356-5c19-bb2e-17ca10a2ea15")
	)
	(text "GPIO5 / LCD_BL low: Q1 off, AL5802 enabled.\nGPIO5 high: Q1 on, EN low, backlight off.\nAL5802 nominal I = 0.65V / 27 ohm = 24.1mA.\nRequire BIAS >= 4.5V and OUT >= 0.8V.\nMeasure LED current, sink voltage and temperature.\nBrief current-limited flash is possible before 3.3V rises."
		(at 284 237 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e5d46e98-be11-5ed4-be8d-409f62385ebd")
	)
